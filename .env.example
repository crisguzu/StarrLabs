# Local-only example. Supply your own database password and provider credentials.
# Generate missing session/auth secrets with scripts/generate_local_secrets.py.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=starrlabs
DB_EXPECTED_NAME=starrlabs
DB_USER=starrlabs
DB_PASSWORD=
DB_TARGET=self-hosted-postgres
DB_ALLOWED_HOSTS=127.0.0.1,localhost
DB_SSLMODE=disable
DB_POOL_MIN=1
DB_POOL_MAX=8
REJECT_SUPABASE_HOSTS=1
SESSION_SECRET=
EMAIL_AUTH_SECRET=
SESSION_HTTPS_ONLY=0
API_TOKEN=
BRAWLSTARS_API_TOKEN=
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
STARRLABS_EMAIL_FROM="StarrLabs <sender@example.invalid>"
STARRLABS_ALLOWED_HOSTS=127.0.0.1,localhost
STARRLABS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
STARRLABS_TURNSTILE_HOSTNAMES=127.0.0.1,localhost
STARRLABS_COLLECTION_ENABLED=0
STARRLABS_REMOTE_MEDIA_ENABLED=0
EMAIL_AUTH_DAILY_SEND_LIMIT=100
